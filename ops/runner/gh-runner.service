[Unit]
Description=Ephemeral GitHub Actions runner for Ayyitskevin/beacon
Documentation=https://docs.github.com/en/actions/reference/runners/self-hosted-runners
Wants=network-online.target docker.service
After=network-online.target docker.service
# --ephemeral removes this file after one completed job. The condition keeps
# Restart=always useful for crashes without turning a consumed runner into a
# restart loop; re-registration creates the file for the next manual start.
ConditionPathExists=/var/lib/gh-runner/actions-runner/.runner
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gh-runner
Group=gh-runner
# The clean-host first-run harness invokes Docker. This is the only supplemental
# group and is deliberately scoped to this service rather than the login user.
SupplementaryGroups=docker
WorkingDirectory=/var/lib/gh-runner/actions-runner
Environment=HOME=/var/lib/gh-runner
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/test ! -r /home/kevin-lee
ExecStart=/usr/bin/bash /var/lib/gh-runner/actions-runner/run.sh
# actions/cache is the sole cross-job cache. Remove the job container's local
# workspace after its post-job cache save and before another registration.
ExecStopPost=+/usr/bin/find /__w -xdev -mindepth 1 -delete
Restart=always
RestartSec=10s
TimeoutStopSec=5min
KillSignal=SIGINT

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gh-runner /__w /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
