{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beacon",
  "version": "0.1.0",
  "identifier": "dev.beacon.phase0",
  "build": {
    "beforeDevCommand": "../../scripts/stage-sidecar && npm run dev",
    "beforeBuildCommand": "../../scripts/stage-sidecar && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beacon",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "../../../target/sidecar/beacond"
    ]
  }
}
