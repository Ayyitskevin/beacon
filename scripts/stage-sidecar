#!/usr/bin/env bash
#
# Build beacond and stage it under the target-triple name Tauri's externalBin
# expects. One implementation, called from three places: the gate's cargo-only
# stage, and tauri.conf.json's beforeBuildCommand and beforeDevCommand.
#
# It existed three times before, in three shapes, and the shapes had already
# drifted in failure semantics -- the gate's copy reported a failed release
# build as success. Failure handling is the thing least likely to be kept in
# sync by hand, so it lives in one file.
#
# The staged file is the one THIS build produced. Copying a fixed
# `target/release/beacond` looked equivalent and is not: Cargo's output
# directory moves with CARGO_TARGET_DIR or build.target-dir, so a successful
# build elsewhere plus an older binary at the default path packaged the older
# bytes and exited 0. The path comes from Cargo's own artifact message instead,
# and no executable reported is a refusal rather than a fallback.
#
# The staging DESTINATION stays repo-relative on purpose: tauri.conf.json names
# `../../../target/sidecar/beacond`, so that is where tauri-build looks however
# Cargo's own output directory is configured.
#
# Runs from anywhere: callers have different working directories.

set -euo pipefail

cd "$(dirname "$0")/.."

triple="$(rustc -vV | awk '/^host:/ {print $2}')"
# An empty triple would stage `beacond-` and satisfy nothing.
if [ -z "$triple" ]; then
    echo "stage-sidecar: could not determine the host target triple" >&2
    exit 1
fi

# A cross build produces a binary for one triple while this script would name it
# for another. Refuse loudly rather than stage a mislabelled sidecar.
if [ -n "${CARGO_BUILD_TARGET:-}" ] && [ "$CARGO_BUILD_TARGET" != "$triple" ]; then
    echo "stage-sidecar: CARGO_BUILD_TARGET=$CARGO_BUILD_TARGET is not the host triple $triple" >&2
    exit 1
fi

# Cargo reports the path of every artifact it produced. Take beacond's from
# there rather than assuming where it landed.
executable="$(
    cargo build --release -p beacond --message-format=json-render-diagnostics |
        python3 -c '
import json
import sys

executable = ""
for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    if message.get("reason") != "compiler-artifact":
        continue
    target = message.get("target") or {}
    if target.get("name") != "beacond":
        continue
    if "bin" not in (target.get("kind") or []):
        continue
    if message.get("executable"):
        executable = message["executable"]
print(executable)
'
)"

if [ -z "$executable" ]; then
    echo "stage-sidecar: cargo produced no beacond executable" >&2
    exit 1
fi

mkdir -p target/sidecar
cp "$executable" "target/sidecar/beacond-$triple"
