#!/usr/bin/env bash
# Shared closed vocabulary for the container driver's observable step states.
# This file is sourced; it performs no work on its own.

first_run_wait_failure() {
    local wait_status="$1"
    local transition="$2"

    case "$wait_status" in
        1)
            printf 'absent\t%s was not observed before timeout\n' "$transition"
            ;;
        2)
            printf 'broken\t%s could not complete because the AppImage exited\n' "$transition"
            ;;
        3)
            printf 'broken\t%s was observed, but its redacted evidence could not be produced\n' \
                "$transition"
            ;;
        *)
            printf 'broken\t%s returned an unknown wait status (%s)\n' \
                "$transition" "$wait_status"
            ;;
    esac
}

first_run_scan_for_secrets() {
    python3 - "$@" <<'PY'
import os
import pathlib
import re
import stat
import sys

patterns = (
    ("fixture password", re.compile(rb"beacon-clean-host-passphrase-2026")),
    ("Recovery Key", re.compile(rb"(?<![A-Z2-7])(?:[A-Z2-7]{4}-){7}[A-Z2-7]{4}(?![A-Z2-7])")),
    (
        "password-shaped value",
        re.compile(rb"(?i)(?:password|passphrase)\s*[:=]\s*[\"']?[^\s\"']{8,}"),
    ),
    (
        "token-shaped value",
        re.compile(
            rb"(?i)(?:access[_-]?token|refresh[_-]?token|client[._-]?token|token)"
            rb"\s*[:=]\s*[\"']?[A-Za-z0-9_./+=-]{16,}"
        ),
    ),
)

def reject(kind, path):
    print(f"clean-host-first-run: secret scan refused {kind} in {path}", file=sys.stderr)

artifacts = []
invalid = False
for raw_root in sys.argv[1:]:
    root = pathlib.Path(raw_root)
    if root.is_symlink():
        reject("symbolic-link artifact", root.name)
        invalid = True
        continue
    if root.is_dir():
        for directory, names, files in os.walk(root, followlinks=False):
            directory_path = pathlib.Path(directory)
            for name in names:
                child = directory_path / name
                if child.is_symlink():
                    reject("symbolic-link artifact", child.relative_to(root))
                    invalid = True
            for name in files:
                artifacts.append((directory_path / name, root))
    else:
        artifacts.append((root, root.parent))

for artifact, root in artifacts:
    try:
        metadata = artifact.lstat()
    except OSError:
        reject("unreadable artifact", artifact.name)
        invalid = True
        continue
    display = artifact.relative_to(root) if artifact != root else artifact.name
    if not stat.S_ISREG(metadata.st_mode):
        reject("non-regular artifact", display)
        invalid = True
        continue
    try:
        content = artifact.read_bytes()
    except OSError:
        reject("unreadable artifact", display)
        invalid = True
        continue
    for kind, pattern in patterns:
        if pattern.search(content):
            reject(kind, display)
            invalid = True

raise SystemExit(1 if invalid else 0)
PY
}

first_run_begin_step() {
    first_run_active_step="$1"
    first_run_active_transition="$2"
}

first_run_finish_step() {
    local step="$1"
    if [ "${first_run_active_step:-}" = "$step" ]; then
        first_run_active_step=""
        first_run_active_transition=""
    fi
}

first_run_mark_interrupted() {
    local signal="$1"
    if [ -z "${first_run_active_step:-}" ]; then
        return 0
    fi
    python3 - \
        "$first_run_result" \
        "$first_run_active_step" \
        "$first_run_active_transition" \
        "$signal" <<'PY'
import json
import sys

path, step, transition, signal = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    document = json.load(handle)
if step not in document["steps"]:
    raise SystemExit(f"active step is absent from result vocabulary: {step}")
document["steps"][step] = {
    "status": "broken",
    "detail": f"{transition} was interrupted by {signal}",
    "artifacts": [],
}
with open(path, "w", encoding="utf-8") as handle:
    json.dump(document, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
}

first_run_handle_signal() {
    local signal="$1"
    local exit_status
    case "$signal" in
        INT) exit_status=130 ;;
        TERM) exit_status=143 ;;
        *) exit_status=1 ;;
    esac
    trap - INT TERM
    if ! first_run_mark_interrupted "$signal"; then
        echo "drive-first-run: could not record interrupted active step" >&2
    fi
    exit "$exit_status"
}

first_run_install_signal_traps() {
    trap 'first_run_handle_signal INT' INT
    trap 'first_run_handle_signal TERM' TERM
}
