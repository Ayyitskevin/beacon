#!/usr/bin/env bash
#
# Run every gate and exit non-zero if ANY of them fails.
#
# Use it as the left side of a commit:
#
#     scripts/gate && git commit -m "..."
#
# WHY THIS EXISTS. Five times in one session a gate failed and the work proceeded
# anyway, every time because a shell construct's failure mode is "quietly does
# nothing":
#
#   `a && b`         b silently skipped when a fails for an unrelated reason
#   `ruff | tail -1` the pipe's exit status is tail's, so a failing ruff reads as 0
#   `ls | head -3`   truncated a listing and a present file looked missing
#   `str.replace()`  no-op'd against text that was not there, reporting nothing
#   `a ; b`          b runs regardless — this one let an unformatted commit through
#
# A later harness defect was duplicate ownership: the desktop stage ran
# `cargo test -p beacon-desktop`, then the Rust stage ran those same tests again
# through `cargo test --workspace`. The Rust stage owns every workspace package test.
#
# None of those were in the code under test. All were in the tooling that was
# supposed to be checking it. The code failed loudly; the harness failed silently.
#
# So this script has no pipes into anything that consumes an exit status, no `;`
# chaining between checks, and `set -euo pipefail` on top. Each check prints its own
# name and its own status, so a passing run is legible rather than merely quiet.
#
# Run one stage only:
#   scripts/gate lint | scripts/gate format | scripts/gate test
#   scripts/gate desktop | scripts/gate rust
#
# Skip the stages that need the Python env (a fresh review worktree pays ten
# minutes for a `.venv` it does not need to compile Rust or build the desktop
# app):
#   scripts/gate --no-venv all | scripts/gate --no-venv rust
#
# CONTRIBUTING is the source of the split, and it names exactly two exempt
# stages: rust and desktop use none of the Python tree. --no-venv therefore
# SKIPS lint/format/test and says so, one line per stage -- a stage that is not
# run must never be indistinguishable from one that passed, which is this
# file's whole subject. Asking for a Python stage BY NAME under --no-venv is a
# refusal, not a skip: silently exiting 0 on the stage you explicitly requested
# is the false green in its purest form.

set -euo pipefail

cd "$(dirname "$0")/.."

failed=0
PY=".venv/bin/python"
RUFF=".venv/bin/ruff"

# The stages CONTRIBUTING lists as needing the Python env. Everything not named
# here runs in a checkout that has no .venv.
VENV_STAGES="lint format test"
VENV_REASON="needs .venv (Python); CONTRIBUTING exempts only rust and desktop"

usage() {
    cat <<'USAGE'
usage: scripts/gate [--no-venv] [stage]

stages:
  lint      ruff check                        (needs .venv)
  format    ruff format --check               (needs .venv)
  test      pytest                            (needs .venv)
  desktop   npm ci, npm test, build, Tauri build
  rust      stage sidecar, cargo fmt/clippy/test/build
  all       every stage, in that order        (default)

options:
  --no-venv  run only the stages that need no Python env (desktop, rust).
             Skipped stages are named on stdout, one line each. Naming a
             stage that needs .venv together with --no-venv is refused
             rather than skipped.
  -h, --help this text.

exit: 0 all checks passed - 1 a check failed - 2 usage, or a missing .venv
USAGE
}

stage=""
no_venv=0
for arg in "$@"; do
    case "$arg" in
        --no-venv) no_venv=1 ;;
        -h|--help) usage; exit 0 ;;
        -*)
            echo "gate: unknown option '$arg' (--no-venv|--help)" >&2
            exit 2
            ;;
        *)
            if [ -n "$stage" ]; then
                echo "gate: one stage at a time (got '$stage' and '$arg')" >&2
                exit 2
            fi
            stage="$arg"
            ;;
    esac
done
stage="${stage:-all}"

needs_venv() {
    case " $VENV_STAGES " in *" $1 "*) return 0 ;; esac
    return 1
}

if [ "$no_venv" -eq 1 ]; then
    # Refuse, never skip: the caller named this stage on purpose.
    if needs_venv "$stage"; then
        echo "gate: stage '$stage' $VENV_REASON." >&2
        echo "gate: --no-venv cannot run it -- drop the flag, or run 'rust'/'desktop'." >&2
        exit 2
    fi
elif needs_venv "$stage" || [ "$stage" = all ]; then
    if [ ! -x "$PY" ]; then
        echo "gate: no .venv in $(pwd) -- create one and install this worktree editable." >&2
        echo "gate: importing another checkout's copy is the false-green this repo has hit." >&2
        echo "gate: 'scripts/gate --no-venv $stage' runs the stages that do not need it." >&2
        exit 2
    fi
fi

run() {
    local name="$1"; shift
    if "$@"; then
        printf '  ok    %s\n' "$name"
    else
        printf '  FAIL  %s\n' "$name"
        failed=1
    fi
}

run_in_desktop() {
    (
        cd apps/desktop
        "$@"
    )
}

# The desktop crate declares beacond as a Tauri sidecar, so tauri-build refuses to
# compile it until the staged binary exists -- including under --no-bundle. The
# desktop stage gets that for free from `tauri build`, which runs beforeBuildCommand;
# a cargo-only stage does not, and would fail before compiling anything.
#
# Every step propagates explicitly, and this file's header names why that
# matters. `run` is called after the script enters `set +e`, so a function body
# of independent commands reports only its LAST command: a FAILED release build
# followed by a successful `cp` of a stale binary printed `ok stage sidecar` and
# the gate exited 0 -- a construct whose failure mode is "quietly does nothing",
# checking the very build it was added to protect.
#
# `set -e` in a subshell does NOT fix that. `run` calls this as `if "$@"; then`,
# and -e is suppressed for a command whose status is being tested; the first
# attempted repair was written that way and the injected failure still printed
# ok. A separate script has its own shell, so its `set -e` is its own, and its
# exit status is all this function returns.
# tests/harness/test_gate_sidecar_staging.py injects the failure permanently.
stage_sidecar() {
    scripts/stage-sidecar
}

# One owner per group. Before --no-venv, the `all` case carried a second copy of
# every stage's check list; a third would have been the point where `all` and the
# single-stage cases drifted apart without anything failing.
python_checks() {
    run "ruff check"  "$RUFF" check src tests
    run "ruff format" "$RUFF" format --check src tests
    run "pytest"      "$PY" -m pytest -q
}

# The desktop tests run SHUFFLED, with the seed chosen here, printed, and overridable.
#
# Why: a #48 test asserted a status line synchronously right after an async unlock. It passed every
# full-file run, failed 100% when run alone, and failed one full gate on main -- an order-dependent
# test the gate let through to the default branch.
#
# Measured on this branch with that test's pre-fix form restored, 30 full runs:
#
#   unshuffled   0 / 10 runs failed
#   shuffled     7 / 20 runs failed        (and all 7 are the #48 test, by name)
#   shuffled, against the FIXED test: 0 / 4 -- the detector is specific, not just noisy
#
# So shuffling is a real detector and NOT a complete one: about a third of runs catch this class,
# which converges over PRs rather than guaranteeing any single one. It is worth having because it
# costs nothing -- the stage takes the same ~15s either way -- but a green shuffled stage is weaker
# evidence than it looks, and this comment is where that is written down.
#
# THE SEED DOES NOT REPLAY THIS PARTICULAR FAILURE, and that was measured too: seed 2 failed once
# and then passed six consecutive runs. Ordering is what exposes the dependency; whether the race is
# lost inside a given ordering is still timing. The seed is printed because for a purely
# order-dependent test it does reproduce the order, and because a random order nobody recorded is a
# bug report that cannot be investigated at all -- not because it makes every failure replayable.
# Replay with `GATE_VITEST_SEED=<printed seed> scripts/gate desktop`, and expect to repeat it.
#
# The seed is in the step NAME so it appears on the ok line and the FAIL line alike -- and it is a
# VERIFIED claim, not a label: `scripts/desktop-tests` reads the seed back out of vitest's own
# report and refuses if it differs or is missing. Printing a number nobody checked is worse than
# printing none, because it is the number that ends up quoted in the bug report. Dropping the
# `--sequence.seed` argument and dropping `--sequence.shuffle` both fail the step, with different
# messages; that was measured, not assumed.
#
# `npm test -- <args>` does forward to vitest (checked with `-t`), so the stage keeps going through
# the package script rather than reaching past it to `npx vitest`.
desktop_checks() {
    local seed="${GATE_VITEST_SEED:-$(date +%s)}"
    run "npm clean install" run_in_desktop npm ci --ignore-scripts
    run "desktop tests (shuffled, seed $seed)" scripts/desktop-tests "$seed"
    run "desktop build"    run_in_desktop npm run build
    run "Tauri build"      run_in_desktop npm run tauri build -- --no-bundle
}

rust_checks() {
    run "stage sidecar" stage_sidecar
    run "cargo fmt"    cargo fmt --all --check
    run "cargo clippy" cargo clippy --workspace --all-targets --all-features -- -D warnings
    run "cargo test"   cargo test --workspace --all-targets
    run "cargo build"  cargo build --workspace --all-targets
}

# A stage that was not run must be as visible as one that failed.
skipped=""
skip() {
    printf '  skip  %-16s -- %s\n' "$1" "$2"
    skipped="${skipped:+$skipped, }$1"
}

echo "gate: $(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)"

# `run` must not abort the script on a failure, so the remaining checks still report.
set +e
case "$stage" in
    lint)    run "ruff check"  "$RUFF" check src tests ;;
    format)  run "ruff format" "$RUFF" format --check src tests ;;
    test)    run "pytest"      "$PY" -m pytest -q ;;
    desktop) desktop_checks ;;
    rust)    rust_checks ;;
    all)
        if [ "$no_venv" -eq 1 ]; then
            for venv_stage in $VENV_STAGES; do
                skip "$venv_stage" "$VENV_REASON"
            done
        else
            python_checks
        fi
        desktop_checks
        rust_checks
        ;;
    *) echo "gate: unknown stage '$stage' (lint|format|test|desktop|rust|all)" >&2; exit 2 ;;
esac
set -e

if [ "$failed" -ne 0 ]; then
    echo "gate: FAILED -- not safe to commit." >&2
    exit 1
fi

# A green partial run must not read like a green full one.
if [ -n "$skipped" ]; then
    echo "gate: checks passed, but SKIPPED $skipped -- this is not a full gate."
    echo "gate: run without --no-venv (after creating .venv) before committing."
else
    echo "gate: all checks passed."
fi
